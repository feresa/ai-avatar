# 複製這個檔改名成 .env，填上要用的金鑰（.env 不會上傳到 GitHub）
# 全部都是選填：沒用到的功能可以空著

# ── 自動產生插圖（npm run images）──
# 有填就用 OpenAI 畫圖（品質較好，每張約 1~2 元台幣）；沒填就用免費的 Pollinations
OPENAI_API_KEY=
# 圖庫真實照片（inserts 用 stock 欄位時），免費申請：https://www.pexels.com/api/
PEXELS_API_KEY=

# ── 發佈到 YouTube（npm run publish）──
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ── 發佈到 Instagram（npm run publish）──
IG_USER_ID=
IG_ACCESS_TOKEN=

# ── 發佈到 Facebook 粉絲專頁 Reels（npm run publish）──
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# ── 發佈到 Threads（npm run publish）──
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
# Threads API 需要從公開網址抓取影片。如果有上傳到 CDN/R2/S3，填寫基礎網址（如 https://pub-xxx.r2.dev）
PUBLIC_VIDEO_BASE_URL=

# ── like-manychat 自動私訊規則連動（npm run manychat / publish 時自動同步）──
# 例如 https://your-like-manychat.vercel.app（沒用到就空著）
LIKE_MANYCHAT_URL=
LIKE_MANYCHAT_EMAIL=
LIKE_MANYCHAT_PASSWORD=
